{
  "name": "youtube-codemode-mcp",
  "version": "1.0.0",
  "description": "Code Mode MCP server for the YouTube Data, Analytics, and Reporting APIs. Three tools: docs, search, execute.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "youtube",
    "youtube-analytics",
    "youtube-data-api",
    "claude",
    "code-mode"
  ],
  "homepage": "https://github.com/poamslayer/youtube-codemode-mcp#readme",
  "bugs": {
    "url": "https://github.com/poamslayer/youtube-codemode-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/poamslayer/youtube-codemode-mcp.git"
  },
  "type": "module",
  "license": "MIT",
  "bin": {
    "youtube-codemode-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "sandbox",
    "specs",
    "guides",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js",
    "fetch-specs": "node scripts/fetch-specs.mjs",
    "check-guides": "npm run build && node scripts/check-guides.mjs",
    "prepare": "npm run build",
    "prepublishOnly": "npm run clean && npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "workerd": "^1.20261002.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
